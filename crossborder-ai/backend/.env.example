# VeyaShip - 服务商环境配置
# 本文件只需配置一次，卖家用户无需任何操作

# DeepSeek AI（必配，否则 AI 生成功能不可用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 数据库（默认 SQLite 开发模式，生产改用 PostgreSQL）
USE_SQLITE=true

# JWT 密钥（生产环境请修改）
JWT_SECRET_KEY=change-me-jwt-secret

# 敏感字段独立加密密钥（生产环境必须配置高熵随机值）
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_PREVIOUS_KEYS=

# PostgreSQL TLS（生产建议 verify-full）
DB_SSL_MODE=disable
DB_SSL_CA_PATH=

# 数据保留策略
DATA_RETENTION_ENABLED=true
DATA_RETENTION_DAYS=90
DATA_RETENTION_STORE_CHECK_DAYS=180
DATA_RETENTION_BATCH_SIZE=500
DATA_RETENTION_DRY_RUN=false

# 1688 数据接口（可选，配了可提高抓取成功率）
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=

# IP 图片风险初筛（复用服务商设置中的阿里云 DashScope Key）
IP_VISION_MODEL=qwen3-vl-plus
IP_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 平台政策 RAG（复用同一阿里云百炼 Key）
POLICY_EMBEDDING_ENABLED=true
POLICY_EMBEDDING_MODEL=text-embedding-v4
POLICY_EMBEDDING_DIMENSION=1024
POLICY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
POLICY_QDRANT_COLLECTION=platform_policies
