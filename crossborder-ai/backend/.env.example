# VeyaShip - 服务商环境配置
# 本文件只需配置一次，卖家用户无需任何操作

# DeepSeek AI（必配，否则 AI 生成功能不可用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 数据库（默认 SQLite 开发模式，生产改用 PostgreSQL）
USE_SQLITE=true

# JWT 密钥（生产环境请修改）
JWT_SECRET_KEY=change-me-jwt-secret

# 敏感字段独立加密密钥（生产环境必须配置高熵随机值）
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_PREVIOUS_KEYS=

# PostgreSQL TLS（生产建议 verify-full）
DB_SSL_MODE=disable
DB_SSL_CA_PATH=

# 数据保留策略
DATA_RETENTION_ENABLED=true
DATA_RETENTION_DAYS=90
DATA_RETENTION_STORE_CHECK_DAYS=180
DATA_RETENTION_BATCH_SIZE=500
DATA_RETENTION_DRY_RUN=false
WORKSPACE_ARCHIVE_RETENTION_DAYS=30
BILLING_OBSERVATION_ENABLED=false
BILLING_OBSERVATION_DIR=./storage/billing-observations
BILLING_OBSERVATION_BATCH_SIZE=500

# 语音输入与转写
AUDIO_STORAGE_DIR=./storage/audio
AUDIO_STORAGE_BACKEND=local
AVATAR_STORAGE_DIR=./storage/avatars
AUDIO_OBJECT_PREFIX=private/audio
MAX_AUDIO_UPLOAD_BYTES=26214400
AUDIO_RETENTION_HOURS=24
ALIYUN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_ASR_MODEL=qwen3-asr-flash

# 生产 S3 / MinIO 语音存储（AUDIO_STORAGE_BACKEND=s3 时启用）
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256

# 公共商品图片托管（Amazon 等平台必须能直接读取 HTTPS URL）
PUBLIC_MEDIA_BASE_URL=https://media.your-domain.com
PUBLIC_MEDIA_S3_BUCKET=
PUBLIC_MEDIA_PREFIX=public/images

# 1688 数据接口（可选，配了可提高抓取成功率）
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=

# Amazon 市场数据（Jungle Scout，仅 us）
JUNGLE_SCOUT_KEY_NAME=
JUNGLE_SCOUT_API_KEY=
JUNGLE_SCOUT_MARKETPLACE=us

# IP 图片风险初筛（复用服务商设置中的阿里云 DashScope Key）
IP_VISION_MODEL=qwen3-vl-plus
IP_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 平台政策 RAG（复用同一阿里云百炼 Key）
POLICY_EMBEDDING_ENABLED=true
POLICY_EMBEDDING_MODEL=text-embedding-v4
POLICY_EMBEDDING_DIMENSION=1024
POLICY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
POLICY_QDRANT_COLLECTION=platform_policies

# Shopify 动作护栏（按店铺币种计）
SHOPIFY_API_VERSION=2026-10
MAX_REFUND_AMOUNT=100
MAX_DAILY_REFUND_TOTAL=300

# Temu 开放平台（US / EU / GLOBAL 共用同一应用凭据）
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_REDIRECT_URI=https://your-domain.com/api/v1/platforms/temu/callback
TEMU_DEFAULT_REGION=global
