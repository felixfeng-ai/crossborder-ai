# VeyaShip - Environment Configuration
# ====================================

# --- Application ---
APP_NAME="VeyaShip"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_PREFIX=/api/v1
PROJECT_ROOT=/app
APP_URL=https://your-domain.com

# --- PostgreSQL ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crossborder_ai
POSTGRES_USER=crossborder
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Database Mode ---
# 生产环境必须设为 false，使用 PostgreSQL
USE_SQLITE=false

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 天，卖家不需要频繁登录
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=crossborder_embeddings

# --- DeepSeek ---
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7

# --- Replicate ---
REPLICATE_API_KEY=your-replicate-api-key
REPLICATE_MODEL=black-forest-labs/flux-schnell

# --- Image Workbench ---
IMAGE_STORAGE_DIR=./storage/images
MAX_IMAGE_UPLOAD_BYTES=12582912

# --- MiniMax H3 Video ---
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_VIDEO_BASE_URL=https://api.minimax.cn
MINIMAX_VIDEO_MODEL=MiniMax-H3-Lite
MINIMAX_VIDEO_RESOLUTION=480P
VIDEO_STORAGE_DIR=./storage/videos

# --- Just One API (1688 商品详情优先数据源) ---
JUSTONE_API_TOKEN=your-justone-api-token

# --- Amazon SP-API ---
AMAZON_APP_ID=amzn1.sp.solution.your-app
AMAZON_CLIENT_ID=amzn1.application-oa2-client.your-client
AMAZON_CLIENT_SECRET=your-amazon-client-secret
AMAZON_REDIRECT_URI=https://your-domain.com/api/v1/platforms/amazon/callback

# --- Shopify ---
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_REDIRECT_URI=https://your-domain.com/api/v1/shopify/callback

# --- Creem.io Payment ---
CREEM_API_KEY=your-creem-api-key
CREEM_WEBHOOK_SECRET=your-creem-webhook-secret
CREEM_PUBLISHABLE_KEY=your-creem-publishable-key

# --- Redis / Celery (optional) ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
