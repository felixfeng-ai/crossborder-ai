# VeyaShip - 前端生产环境变量
# 当使用独立部署（不通过 nginx 反向代理）时，需要配置 API 地址
# 如果使用 docker-compose.prod.yml + nginx，留空即可（nginx 自动代理 /api/）
VITE_API_BASE_URL=/api/v1
# Android 内测安装包地址。请在 EAS 产物过期前替换为官网稳定下载地址。
VITE_MOBILE_APP_DOWNLOAD_URL=https://expo.dev/artifacts/eas/bKteV0OXlh1tOtesB0X4C3AEb3qz5P64R0TRCu3FnI8.apk
