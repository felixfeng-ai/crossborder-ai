{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://veyaship.com",
        "EXPO_PUBLIC_PREVIEW_MODE": "0",
        "EXPO_PUBLIC_REQUIRE_REMOTE_API": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "ui-preview": {
      "distribution": "internal",
      "channel": "ui-preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_PREVIEW_MODE": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_PREVIEW_MODE": "0",
        "EXPO_PUBLIC_REQUIRE_REMOTE_API": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
